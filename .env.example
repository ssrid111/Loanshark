# Copy to .env. Replace placeholders locally; never commit the completed file.
DATABASE_URL=postgresql+asyncpg://loanshark_runtime:REPLACE_RUNTIME_PASSWORD@127.0.0.1:55432/loanshark
MIGRATION_DATABASE_URL=postgresql+asyncpg://loanshark_migrator:REPLACE_MIGRATION_PASSWORD@127.0.0.1:55432/loanshark
TEST_DATABASE_URL=postgresql+asyncpg://loanshark_migrator:REPLACE_MIGRATION_PASSWORD@127.0.0.1:55432/loanshark_test
TEST_RUNTIME_DATABASE_URL=postgresql+asyncpg://loanshark_runtime:REPLACE_RUNTIME_PASSWORD@127.0.0.1:55432/loanshark_test
POSTGRES_PASSWORD=REPLACE_ADMIN_PASSWORD
MIGRATION_PASSWORD=REPLACE_MIGRATION_PASSWORD
RUNTIME_PASSWORD=REPLACE_RUNTIME_PASSWORD
DEFAULT_TIMEZONE=America/Phoenix
LOG_LEVEL=INFO
# Future integrations are deliberately disabled in this milestone.
ENABLE_DISCORD=false
ENABLE_PRIVATE_API=false
LLM_PROVIDER=none
# Add real provider credentials only when a later milestone implements them.
# DISCORD_BOT_TOKEN=REPLACE_DISCORD_BOT_TOKEN
# ANTHROPIC_API_KEY=REPLACE_ANTHROPIC_API_KEY
